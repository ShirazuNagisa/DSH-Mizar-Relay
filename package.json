{
  "name": "dsh-mizar-relay",
  "version": "0.3.2",
  "description": "Reverse tunnel that lets the DSH-Mizar iOS app reach a computer from any network, with no inbound port.",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node lib/index.js",
    "pack": "deploy/pack.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
